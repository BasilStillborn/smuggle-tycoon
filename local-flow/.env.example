# Required: Change to your actual domain
NEXT_PUBLIC_SITE_URL=https://localflowhub.com

# Google Analytics (optional — leave empty to disable)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Mailchimp (optional — leave empty to disable email capture)
MAILCHIMP_API_KEY=your-api-key-us1
MAILCHIMP_LIST_ID=your-audience-id

# Google Sheets (optional — leave empty to disable)
GOOGLE_SHEETS_API_KEY=your-google-api-key
